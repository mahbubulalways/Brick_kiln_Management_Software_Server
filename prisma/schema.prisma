// Database 
enum DatabaseBackupType {
  MANUAL
  AUTO
}

// ========================== DATABASE BACKUP PERMISSION MODEL SUPER ADMIN==================================
model DatabaseBackupPermission {
  id   String             @id @default(uuid())
  type DatabaseBackupType
}

// ========================== DATABASE BACKUP  MODEL==================================
model DatabaseBackup {
  id             String             @id @default(uuid())
  fileName       String
  filePath       String
  fileSize       BigInt
  type           DatabaseBackupType
  tableCount     Int                @default(0)
  totalRowCount  BigInt             @default(0)
  tableRowCounts Json?

  createdAt DateTime @default(now())
}

// =============================EDIT DELETE APPROVAL===========================
model ApprovalRequest {
  id String @id @default(cuid())

  vataId        String
  requestedById String

  action ApprovalAction
  module ModuleType

  targetId String

  oldData Json?
  newData Json?

  status     ApprovalStatus @default(PENDING)
  isDeleted  Boolean        @default(false)
  reviewedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  vata        Vata @relation(fields: [vataId], references: [id])
  requestedBy User @relation(fields: [requestedById], references: [id])

  @@index([vataId, status])
  @@index([targetId])
  @@index([module, targetId])
}

// =============================== ACTIVITY LOG MODEL =============================
model ActivityLog {
  id String @id @default(cuid())

  vataId String
  userId String?

  module ModuleType
  action ActivityAction

  targetId String?

  description String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  vata Vata  @relation(fields: [vataId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([vataId, createdAt])
  @@index([vataId, userId])
  @@index([vataId, module])
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
}

