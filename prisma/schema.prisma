// CAR 
model VataCar {
  id                  String              @id @default(uuid())
  vataId              String
  carNo               String
  vata                Vata                @relation(fields: [vataId], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  carIncomeDeliveries CarIncomeDelivery[]
}

model CarIncomeDelivery {
  id         String   @id @default(uuid())
  amount     Float
  driverId   String
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  driver     Driver   @relation(fields: [driverId], references: [id])
  carId      String
  car        VataCar  @relation(fields: [carId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SYSTEM_ADMIN
  SUPER_ADMIN
}

enum VataStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CashType {
  INCOME
  EXPENSE
}

enum DocumentType {
  FILE
  FOLDER
}

enum TaskStatus {
  COMPLETE
  PENDING
}

enum TransactionType {
  GIVEN
  TAKEN
  PAYMENT
}
