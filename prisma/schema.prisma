generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  name         String         @default("Admin")
  username     String         @unique
  role         UserRole       @default(ADMIN)
  password     String
  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  vataId       String?
  taskManagers TaskManager[]
  challans     Challan[]
  deliveries   Delivery[]
  loginHistory LoginHistory[]
  vata         Vata?          @relation(fields: [vataId], references: [id])

  @@map("users")
}

model LoginHistory {
  id        String   @id @default(uuid())
  type      String
  device    String
  browser   String
  ipAddress String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_histories")
}

model ClassAndRate {
  id          String       @id @default(uuid())
  classType   String
  className   String
  rate        Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  isDeleted   Boolean      @default(false)
  vataId      String
  unloadItems UnloadItem[]
  vata        Vata         @relation(fields: [vataId], references: [id])

  @@unique([vataId, classType, className])
  @@map("classAndRates")
}

model Challan {
  id             String        @id @default(uuid())
  serial         Int
  chalanType     String
  deliveryDate   DateTime
  challanDate    DateTime
  duePaymentDate DateTime?
  note           String?
  productPrice   Float
  discount       Float?
  carRent        Float?
  totalPrice     Float
  cash           Float?
  due            Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customerId     String
  vataId         String
  isDeleted      Boolean       @default(false)
  createdById    String
  seasonId       String
  items          ChallanItem[] @relation("ChallanItems")
  createdBy      User          @relation(fields: [createdById], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  season         Season        @relation(fields: [seasonId], references: [id])
  vata           Vata          @relation(fields: [vataId], references: [id])
  deliveries     Delivery[]

  @@unique([vataId, serial])
  @@map("chllans")
}

model ChallanItem {
  id           String   @id @default(uuid())
  class        String
  rate         Float
  quantity     Int
  delivered    Int      @default(0)
  price        Float
  challanId    String
  deliveryDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDeleted    Boolean  @default(false)
  season       String?
  challan      Challan  @relation("ChallanItems", fields: [challanId], references: [id])

  @@map("challanItems")
}

model Customer {
  id              String           @id @default(uuid())
  customerCode    String
  name            String
  address         String
  phoneNumber     String
  totalPurchased  Float            @default(0)
  totalPaid       Float            @default(0)
  nextPaymentDate DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isDeleted       Boolean          @default(false)
  note            String?
  vataId          String
  seasonId        String
  challans        Challan[]
  season          Season           @relation(fields: [seasonId], references: [id])
  vata            Vata             @relation(fields: [vataId], references: [id])
  dueCollections  Due_Collection[]

  @@unique([vataId, customerCode])
  @@map("customers")
}

model Delivery {
  id                String    @id @default(uuid())
  deliveryDate      DateTime
  deliveryNo        Int
  nextDeliveryDate  DateTime?
  quantity          Int
  deliveryReceived  Int
  class             String
  deliveryRemaining Int
  driverName        String?
  driverPhoneNumber String?
  carNo             String?
  carRent           Float?
  invoiceId         String
  isDeleted         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  season            String?
  deliveryById      String
  deliveryBy        User      @relation(fields: [deliveryById], references: [id])
  invoice           Challan   @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, deliveryNo])
  @@map("deliveries")
}

model Due_Collection {
  id         String    @id @default(uuid())
  due        Float
  collect    Float
  newDue     Float
  nextDate   DateTime?
  customerId String
  isDeleted  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer  @relation(fields: [customerId], references: [id])

  @@map("due_collections")
}

model Ledger {
  id        String    @id @default(uuid())
  name      String
  serial    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  parentId  String?
  rate      Float?    @default(0)
  quantity  Float?    @default(0)
  isDeleted Boolean   @default(false)
  vataId    String
  parent    Ledger?   @relation("LedgerHierarchy", fields: [parentId], references: [id])
  children  Ledger[]  @relation("LedgerHierarchy")
  vata      Vata      @relation(fields: [vataId], references: [id])
  payments  Payment[]

  @@unique([vataId, serial])
}

model Payment {
  id                String   @id @default(uuid())
  quantity          Float
  cutting           Float    @default(0)
  payment           Float
  ledgerId          String
  vataId            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  document          String?
  paymentDetails    String?
  paymentDifference Float    @default(0)
  paymentType       String
  rate              Float
  totalBill         Float
  isDeleted         Boolean  @default(false)
  paymentDate       DateTime @default(now())
  ledger            Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  vata              Vata     @relation(fields: [vataId], references: [id])
}

model Cash {
  id          String   @id @default(uuid())
  type        CashType
  source      String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vataId      String
  vata        Vata     @relation(fields: [vataId], references: [id])

  @@index([type])
  @@index([createdAt])
  @@index([vataId])
  @@map("cash")
}

model Round {
  id        String     @id @default(uuid())
  name      String
  vataId    String
  loadInfos LoadInfo[]
  vata      Vata       @relation(fields: [vataId], references: [id])
  unloads   Unload[]

  @@unique([vataId, name])
  @@index([vataId])
}

model LoadInfo {
  id        String   @id @default(uuid())
  date      DateTime
  roundId   String
  quantity  Int
  loadType  String
  classType String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  round     Round    @relation(fields: [roundId], references: [id])
}

model Unload {
  id          String       @id @default(uuid())
  date        DateTime
  roundId     String
  isDeleted   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  round       Round        @relation(fields: [roundId], references: [id])
  unloadItems UnloadItem[]
}

model UnloadItem {
  id        String       @id @default(uuid())
  unloadId  String
  classId   String
  quantity  Int          @default(0)
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  classType ClassAndRate @relation(fields: [classId], references: [id])
  unload    Unload       @relation(fields: [unloadId], references: [id])

  @@unique([unloadId, classId])
}

model Document {
  id        String       @id @default(cuid())
  name      String
  type      DocumentType
  parentId  String?
  fileUrl   String?
  fileKey   String?
  mimeType  String?
  size      BigInt?
  extension String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  vataId    String
  parent    Document?    @relation("DocumentParent", fields: [parentId], references: [id])
  children  Document[]   @relation("DocumentParent")
  vata      Vata         @relation(fields: [vataId], references: [id])

  @@unique([parentId, name])
  @@index([type])
  @@index([parentId])
}

model CarRent {
  id        String   @id @default(uuid())
  address   String
  area      String
  rent      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vataId    String
  vata      Vata     @relation(fields: [vataId], references: [id])

  @@map("carrents")
}

model Product {
  id           Int       @id @default(autoincrement())
  productName  String
  category     String
  shop         String
  quantity     Int
  price        Decimal   @db.Decimal(12, 2)
  productImage String?
  warranty     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vataId       String
  vata         Vata      @relation(fields: [vataId], references: [id])

  @@index([category])
  @@index([shop])
  @@map("products")
}

model TaskManager {
  id          String     @id @default(uuid())
  description String
  userId      String
  date        DateTime
  repeat      String
  status      TaskStatus @default(PENDING)
  vataId      String
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vata        Vata       @relation(fields: [vataId], references: [id])
}

model ReceivablePayable {
  id              String                         @id @default(uuid())
  transactionType TransactionType
  amount          Decimal                        @db.Decimal(12, 2)
  currentAmount   Decimal                        @db.Decimal(12, 2)
  name            String
  phone           String?
  address         String?
  transactionDate DateTime
  paymentDate     DateTime?
  witnessOne      String?
  witnessTwo      String?
  description     String?
  isDeleted       Boolean                        @default(false)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  vataId          String
  vata            Vata                           @relation(fields: [vataId], references: [id])
  transactions    ReceivablePayableTransaction[]

  @@index([transactionType])
  @@index([phone])
  @@index([isDeleted])
}

model ReceivablePayableTransaction {
  id                  String            @id @default(uuid())
  receivablePayableId String
  type                TransactionType
  amount              Float
  transactionDate     DateTime
  remaining           Float
  description         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  vataId              String
  receivablePayable   ReceivablePayable @relation(fields: [receivablePayableId], references: [id], onDelete: Cascade)
  vata                Vata              @relation(fields: [vataId], references: [id])

  @@index([receivablePayableId])
  @@index([transactionDate])
}

model Contact {
  id         String   @id @default(uuid())
  name       String
  address    String
  occupation String
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  vataId     String
  vata       Vata     @relation(fields: [vataId], references: [id])
}

model Weather {
  id        String   @id @default(uuid())
  linkOne   String?
  linkTwo   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vataId    String
  vata      Vata     @relation(fields: [vataId], references: [id])
}

model Vata {
  id                            String                         @id @default(uuid())
  vataId                        String                         @unique
  nameEnglish                   String
  nameBangla                    String
  address                       String
  ownerName                     String
  ownerPhoneNumber              String
  challansPhoneNumber           String
  smsRate                       Float?
  softwareFee                   Float
  nextPaymentDate               DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  subdomain                     String                         @unique
  contacts                      Contact[]
  documents                     Document[]
  ledgers                       Ledger[]
  payments                      Payment[]
  receivablePayables            ReceivablePayable[]
  receivablePayableTransactions ReceivablePayableTransaction[]
  rounds                        Round[]
  softwareFees                  SoftwareFee[]
  taskManagers                  TaskManager[]
  weather                       Weather[]
  carRents                      CarRent[]
  cash                          Cash[]
  challans                      Challan[]
  classAndRate                  ClassAndRate[]
  customers                     Customer[]
  products                      Product[]
  users                         User[]

  @@map("vatainformation")
}

model SoftwareFee {
  id            String            @id @default(uuid())
  fee           Float
  transactionId String
  sender        String
  status        SoftwareFeeStatus @default(PENDING)
  vataId        String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  vata          Vata              @relation(fields: [vataId], references: [vataId])
}

model Season {
  id        String     @id @default(uuid())
  name      String     @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  challans  Challan[]
  customers Customer[]
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SYSTEM_ADMIN
}

enum CashType {
  INCOME
  EXPENSE
}

enum DocumentType {
  FILE
  FOLDER
}

enum TaskStatus {
  COMPLETE
  PENDING
}

enum TransactionType {
  GIVEN
  TAKEN
  PAYMENT
}

enum SoftwareFeeStatus {
  PENDING
  REJECTED
  APPROVED
}
