generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @default("admin@gmail.com")
  password  String   @default("12345678")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ClassAndRate {
  id        Int      @id @default(autoincrement())
  classType String
  className String
  rate      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  isDeleted Boolean  @default(false)

  @@map("classAndRates")
}

model Challan {
  id             Int           @id @default(autoincrement())
  serial         Int
  chalanType     String
  deliveryDate   DateTime
  challanDate    DateTime
  duePaymentDate DateTime?
  note           String?
  createdBy      String
  productPrice   Float
  discount       Float?
  carRent        Float?
  totalPrice     Float
  cash           Float?
  due            Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customerId     Int
  isDeleted      Boolean       @default(false)
  items          ChallanItem[] @relation("ChallanItems")
  customer       Customer      @relation(fields: [customerId], references: [id])
  deliveries     Delivery[]

  @@map("chllans")
}

model ChallanItem {
  id           Int      @id @default(autoincrement())
  class        String
  rate         Float
  quantity     Int
  delivered    Int      @default(0)
  price        Float
  challanId    Int
  deliveryDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDeleted    Boolean  @default(false)
  challan      Challan  @relation("ChallanItems", fields: [challanId], references: [id])

  @@map("challanItems")
}

model Customer {
  id              Int              @id @default(autoincrement())
  name            String
  address         String
  phoneNumber     String
  totalPurchased  Float            @default(0)
  totalPaid       Float            @default(0)
  nextPaymentDate DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isDeleted       Boolean          @default(false)
  dueCollections  Due_Collection[]
  challans        Challan[]
}

model Delivery {
  id                Int       @id @default(autoincrement())
  deliveryDate      DateTime
  deliveryNo        Int       @unique
  nextDeliveryDate  DateTime?
  quantity          Int
  deliveryReceived  Int
  class             String
  deliveryRemaining Int
  driverName        String?
  driverPhoneNumber String?
  carNo             String?
  carRent           Float?
  invoiceId         Int
  isDeleted         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  invoice           Challan   @relation(fields: [invoiceId], references: [id])

  @@map("deliveries")
}

model Due_Collection {
  id         Int       @id @default(autoincrement())
  due        Float
  collect    Float
  newDue     Float
  nextDate   DateTime?
  customerId Int
  season     String?
  isDeleted  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer  @relation(fields: [customerId], references: [id])
}

model Ledger {
  id        Int       @id @default(autoincrement())
  name      String
  serial    Int       @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  parentId  Int?
  parent    Ledger?   @relation("LedgerHierarchy", fields: [parentId], references: [id])
  children  Ledger[]  @relation("LedgerHierarchy")
  payments  Payment[]
}

model Payment {
  id                Int      @id @default(autoincrement())
  quantity          Float
  cutting           Float    @default(0)
  payment           Float
  ledgerId          Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  document          String?
  paymentDetails    String?
  paymentDifference Float    @default(0)
  paymentType       String
  rate              Float
  totalBill         Float
  isDeleted         Boolean  @default(false)
  paymentDate       DateTime @default(now())
  ledger            Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
}
