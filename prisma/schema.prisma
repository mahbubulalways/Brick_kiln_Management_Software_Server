generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  name         String         @default("Admin")
  username     String         @unique
  role         UserRole       @default(ADMIN)
  password     String
  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  vataId       String?
  taskManagers TaskManager[]
  challans     Challan[]
  deliveries   Delivery[]
  loginHistory LoginHistory[]
  vata         Vata?          @relation(fields: [vataId], references: [id])
  stockBooks   StockBook[]

  @@map("users")
}

model LoginHistory {
  id        String   @id @default(uuid())
  type      String
  device    String
  browser   String
  ipAddress String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_histories")
}

model ClassAndRate {
  id          String       @id @default(uuid())
  classType   String
  className   String
  rate        Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  isDeleted   Boolean      @default(false)
  vataId      String
  vata        Vata         @relation(fields: [vataId], references: [id])
  loadInfos   LoadInfo[]
  unloadItems UnloadItem[]

  @@unique([vataId, classType, className])
  @@map("classAndRates")
}

model Challan {
  id             String        @id @default(uuid())
  serial         Int
  chalanType     String
  deliveryDate   DateTime
  challanDate    DateTime
  duePaymentDate DateTime?
  deliverySeason String?
  note           String?
  productPrice   Float
  discount       Float?
  carRent        Float?
  totalPrice     Float
  cash           Float?
  due            Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customerId     String
  vataId         String
  isDeleted      Boolean       @default(false)
  createdById    String
  seasonId       String
  items          ChallanItem[] @relation("ChallanItems")
  createdBy      User          @relation(fields: [createdById], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  season         Season        @relation(fields: [seasonId], references: [id])
  vata           Vata          @relation(fields: [vataId], references: [id])
  deliveries     Delivery[]
  customerDue    CustomerDue?

  @@unique([vataId, serial])
  @@map("chllans")
}

model ChallanItem {
  id           String   @id @default(uuid())
  class        String
  rate         Float
  quantity     Int
  delivered    Int      @default(0)
  price        Float
  challanId    String
  deliveryDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isDeleted    Boolean  @default(false)
  challan      Challan  @relation("ChallanItems", fields: [challanId], references: [id])

  @@map("challanItems")
}

model Customer {
  id              String           @id @default(uuid())
  customerCode    String
  name            String
  address         String
  phoneNumber     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isDeleted       Boolean          @default(false)
  nextPaymentDate DateTime?
  note            String?
  vataId          String
  challans        Challan[]
  vata            Vata             @relation(fields: [vataId], references: [id])
  dueCollections  Due_Collection[]
  customerDues    CustomerDue[]

  @@unique([vataId, customerCode])
  @@map("customers")
}

model CustomerDue {
  id         String @id @default(uuid())
  customerId String
  seasonId   String
  challanId  String

  totalAmount Decimal @db.Decimal(12, 2)
  paidAmount  Decimal @db.Decimal(12, 2)
  dueAmount   Decimal @db.Decimal(12, 2)

  customer Customer @relation(fields: [customerId], references: [id])
  season   Season   @relation(fields: [seasonId], references: [id])
  challan  Challan  @relation(fields: [challanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challanId])
  @@index([customerId, seasonId])
  @@map("customerdues")
}

model Delivery {
  id                  String              @id @default(uuid())
  deliveryDate        DateTime
  deliveryNo          Int
  nextDeliveryDate    DateTime?
  quantity            Int
  deliveryReceived    Int
  class               String
  deliveryRemaining   Int
  carNo               String?
  lastDelivered       Int?
  carRent             Float?
  invoiceId           String
  isDeleted           Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  season              String?
  deliveryById        String
  driverId            String?
  driver              Driver?             @relation(fields: [driverId], references: [id])
  deliveryBy          User                @relation(fields: [deliveryById], references: [id])
  invoice             Challan             @relation(fields: [invoiceId], references: [id])
  carIncomeDeliveries CarIncomeDelivery[]

  @@unique([invoiceId, deliveryNo])
  @@map("deliveries")
}

model Due_Collection {
  id       String    @id @default(uuid())
  due      Float
  collect  Float
  newDue   Float
  nextDate DateTime?

  customerId String
  seasonId   String

  isDeleted Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id])
  season   Season   @relation(fields: [seasonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, seasonId])
  @@map("duecollections")
}

model Ledger {
  id        String    @id @default(uuid())
  name      String
  serial    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  parentId  String?
  rate      Float?    @default(0)
  quantity  Float?    @default(0)
  isDeleted Boolean   @default(false)
  vataId    String
  seasonId  String
  season    Season    @relation(fields: [seasonId], references: [id])
  parent    Ledger?   @relation("LedgerHierarchy", fields: [parentId], references: [id])
  children  Ledger[]  @relation("LedgerHierarchy")
  vata      Vata      @relation(fields: [vataId], references: [id])
  payments  Payment[]

  @@unique([vataId, serial, name, seasonId])
}

model Payment {
  id                String   @id @default(uuid())
  quantity          Float
  cutting           Float    @default(0)
  payment           Float
  ledgerId          String
  vataId            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  document          String?
  paymentDetails    String?
  paymentDifference Float    @default(0)
  paymentType       String
  rate              Float
  totalBill         Float
  isDeleted         Boolean  @default(false)
  paymentDate       DateTime @default(now())
  ledger            Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  vata              Vata     @relation(fields: [vataId], references: [id])
}

model Cash {
  id          String   @id @default(uuid())
  type        CashType
  source      String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vataId      String
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id])
  vata        Vata     @relation(fields: [vataId], references: [id])

  @@index([type])
  @@index([createdAt])
  @@index([vataId])
  @@map("cash")
}

model Round {
  id        String     @id @default(uuid())
  name      String
  vataId    String
  loadInfos LoadInfo[]
  seasonId  String
  season    Season     @relation(fields: [seasonId], references: [id])
  vata      Vata       @relation(fields: [vataId], references: [id])
  unloads   Unload[]

  @@unique([vataId, name, seasonId])
  @@index([vataId])
}

// LOAD INFO
enum LoadType {
  RAWENTRY
  RAW_TO_FIELD
  FIELD_TO_CHULLI
  STOCK_TO_CHULLI
  CHULLI_TO_FINISHED
  FIELD_TO_STOCK
}

model LoadInfo {
  id        String        @id @default(uuid())
  date      DateTime
  roundId   String
  quantity  Int
  loadType  LoadType
  classId   String?
  class     ClassAndRate? @relation(fields: [classId], references: [id])
  isDeleted Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  round     Round         @relation(fields: [roundId], references: [id])
}

model Unload {
  id        String       @id @default(uuid())
  date      DateTime
  roundId   String
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  round     Round        @relation(fields: [roundId], references: [id])
  items     UnloadItem[]

  @@index([roundId])
}

model UnloadItem {
  id        String        @id @default(uuid())
  unloadId  String
  classId   String?
  quantity  Int           @default(0)
  damaged   Int           @default(0)
  unload    Unload        @relation(fields: [unloadId], references: [id])
  class     ClassAndRate? @relation(fields: [classId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([unloadId])
  @@index([classId])
}

model BrickStockSummary {
  id          String   @id @default(uuid())
  vataId      String
  vata        Vata     @relation(fields: [vataId], references: [id])
  rawBrick    Int      @default(0)
  fieldBrick  Int      @default(0)
  stockBrick  Int      @default(0)
  chulliBrick Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vataId])
}

// STOCK MANAGEMENT
model StockBook {
  id          String   @id @default(uuid())
  class       String
  stockIn     Int      @default(0)
  stockOut    Int      @default(0)
  description String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id])
  vataId      String
  vata        Vata     @relation(fields: [vataId], references: [id])
}

// GOODS STOCK
model GoodsStockCategory {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  vataId      String
  vata        Vata         @relation(fields: [vataId], references: [id])
  goodsStocks GoodsStock[]
}

model GoodsStock {
  id              String             @id @default(uuid())
  name            String
  shop            String
  quantity        Float
  price           Float
  warranty        DateTime?
  image           String?
  categoryId      String
  category        GoodsStockCategory @relation(fields: [categoryId], references: [id])
  vataId          String
  vata            Vata               @relation(fields: [vataId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  goodsIssues     GoodsIssue[]
  goodsLosses     GoodsLoss[]
  goodHistoryLogs GoodHistoryLog[]
}

model GoodsIssue {
  id        String     @id @default(uuid())
  name      String
  location  String
  quantity  Float
  date      DateTime
  image     String?
  goodId    String
  note      String?
  good      GoodsStock @relation(fields: [goodId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum GoodHistoryType {
  ISSUE
  RETURN
}

model GoodHistoryLog {
  id        String          @id @default(uuid())
  type      GoodHistoryType
  receiveBy String
  quantity  Int
  returnBy  String?
  goodId    String
  date      DateTime
  good      GoodsStock      @relation(fields: [goodId], references: [id])
  damage    Int?
  lost      Int?
  okay      Int?
  image     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum GoodLossType {
  DAMAGED
  LOST
}

model GoodsLoss {
  id         String       @id @default(uuid())
  goodId     String
  good       GoodsStock   @relation(fields: [goodId], references: [id])
  quantity   Float
  type       GoodLossType
  lossAmount Float
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

