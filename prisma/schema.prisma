// DOCUMENT
model Document {
  id        String       @id @default(cuid())
  name      String
  type      DocumentType
  parentId  String?
  fileUrl   String?
  fileKey   String?
  mimeType  String?
  size      BigInt?
  extension String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  vataId    String
  parent    Document?    @relation("DocumentParent", fields: [parentId], references: [id])
  children  Document[]   @relation("DocumentParent")
  vata      Vata         @relation(fields: [vataId], references: [id])

  @@unique([parentId, name])
  @@index([type])
  @@index([parentId])
}

model CarRent {
  id        String   @id @default(uuid())
  address   String
  area      String
  rent      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vataId    String
  vata      Vata     @relation(fields: [vataId], references: [id])

  @@map("carrents")
}

model Product {
  id           Int       @id @default(autoincrement())
  productName  String
  category     String
  shop         String
  quantity     Int
  price        Decimal   @db.Decimal(12, 2)
  productImage String?
  warranty     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vataId       String
  vata         Vata      @relation(fields: [vataId], references: [id])

  @@index([category])
  @@index([shop])
  @@map("products")
}

model TaskManager {
  id          String     @id @default(uuid())
  description String
  userId      String
  date        DateTime
  repeat      String
  status      TaskStatus @default(PENDING)
  vataId      String
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vata        Vata       @relation(fields: [vataId], references: [id])
}

model ReceivablePayable {
  id              String                         @id @default(uuid())
  transactionType TransactionType
  amount          Decimal                        @db.Decimal(12, 2)
  currentAmount   Decimal                        @db.Decimal(12, 2)
  name            String
  phone           String?
  address         String?
  transactionDate DateTime
  paymentDate     DateTime?
  witnessOne      String?
  witnessTwo      String?
  description     String?
  isDeleted       Boolean                        @default(false)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  vataId          String
  vata            Vata                           @relation(fields: [vataId], references: [id])
  transactions    ReceivablePayableTransaction[]

  @@index([transactionType])
  @@index([phone])
  @@index([isDeleted])
}

model ReceivablePayableTransaction {
  id                  String            @id @default(uuid())
  receivablePayableId String
  type                TransactionType
  amount              Float
  transactionDate     DateTime
  remaining           Float
  description         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  vataId              String
  receivablePayable   ReceivablePayable @relation(fields: [receivablePayableId], references: [id], onDelete: Cascade)
  vata                Vata              @relation(fields: [vataId], references: [id])

  @@index([receivablePayableId])
  @@index([transactionDate])
}

model Contact {
  id         String   @id @default(uuid())
  name       String
  address    String
  occupation String
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  vataId     String
  vata       Vata     @relation(fields: [vataId], references: [id])
}

model Weather {
  id        String   @id @default(uuid())
  linkOne   String?
  linkTwo   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vataId    String
  vata      Vata     @relation(fields: [vataId], references: [id])
}

model Vata {
  id                            String                         @id @default(uuid())
  vataId                        String                         @unique
  nameEnglish                   String
  nameBangla                    String
  address                       String
  ownerName                     String
  ownerPhoneNumber              String
  challansPhoneNumber           String
  nextPaymentDate               DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  subdomain                     String                         @unique
  status                        VataStatus                     @default(ACTIVE)
  subscriptionPlanId            String?
  subscriptionPlan              SubscriptionPlan?              @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionStart             DateTime?
  subscriptionEnd               DateTime?
  contacts                      Contact[]
  documents                     Document[]
  ledgers                       Ledger[]
  payments                      Payment[]
  receivablePayables            ReceivablePayable[]
  receivablePayableTransactions ReceivablePayableTransaction[]
  rounds                        Round[]
  taskManagers                  TaskManager[]
  weather                       Weather[]
  carRents                      CarRent[]
  cash                          Cash[]
  challans                      Challan[]
  classAndRate                  ClassAndRate[]
  customers                     Customer[]
  products                      Product[]
  users                         User[]
  drivers                       Driver[]
  subscriptionPayments          SubscriptionPayment[]
  // loadTypes                     LoadType[]
  stocks                        StockBook[]
  goodsStockCategories          GoodsStockCategory[]
  goodsStocks                   GoodsStock[]
  brickStockSummaries           BrickStockSummary[]
  vataCars                      VataCar[]

  @@map("vatainformation")
}

// SUBSCRIPTION PLAN
enum SubscriptionPlanType {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model SubscriptionPlan {
  id                   String                @id @default(uuid())
  name                 String                @unique
  type                 SubscriptionPlanType  @unique
  description          String?
  price                Decimal               @db.Decimal(12, 2)
  billingCycle         BillingCycle
  features             String[]
  maxUsers             Int?
  maxStorage           Int? // GB
  maxTasks             Int?
  maxInvoices          Int?
  maxSms               Int?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  vatas                Vata[]
  subscriptionPayments SubscriptionPayment[]
}

model SubscriptionPayment {
  id                 String                    @id @default(uuid())
  vataId             String
  vata               Vata                      @relation(fields: [vataId], references: [id])
  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan          @relation(fields: [subscriptionPlanId], references: [id])
  startDate          DateTime?
  endDate            DateTime?
  amount             Decimal                   @db.Decimal(12, 2)
  status             SubscriptionPaymentStatus @default(PENDING)
  paidAt             DateTime                  @default(now())
  paymentMethod      String
  transactionId      String
  phoneNumber        String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

model Season {
  id             String           @id @default(uuid())
  name           String           @unique
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  challans       Challan[]
  customerDues   CustomerDue[]
  dueCollections Due_Collection[]
  cash           Cash[]
  ledgers        Ledger[]
  rounds         Round[]
  stockBooks     StockBook[]
}

// DRIVER
model Driver {
  id                  String              @id @default(uuid())
  name                String
  PhoneNumber         String
  salary              Decimal             @db.Decimal(12, 2)
  vataId              String
  vata                Vata                @relation(fields: [vataId], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deliveries          Delivery[]
  carIncomeDeliveries CarIncomeDelivery[]
}

