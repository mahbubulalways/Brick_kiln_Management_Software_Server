generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ========================== USER MODEL==================================
model User {
  id               String            @id @default(uuid())
  name             String            @default("Admin")
  username         String            @unique
  role             UserRole          @default(ADMIN)
  password         String
  isDeleted        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  vataId           String?
  taskManagers     TaskManager[]
  challans         Challan[]
  deliveries       Delivery[]
  loginHistory     LoginHistory[]
  vata             Vata?             @relation(fields: [vataId], references: [id])
  stockBooks       StockBook[]
  approvalRequests ApprovalRequest[]
  activityLogs     ActivityLog[]

  @@map("users")
}

// ========================== LOGIN HISTORY MODEL==================================
model LoginHistory {
  id        String   @id @default(uuid())
  type      String
  device    String
  browser   String
  ipAddress String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_histories")
}

// ========================== CLASS AND RATE MODEL==================================
model ClassAndRate {
  id           String         @id @default(uuid())
  classType    String
  className    String
  rate         Float
  advanceRate  Float          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  isDeleted    Boolean        @default(false)
  vataId       String
  vata         Vata           @relation(fields: [vataId], references: [id])
  loadInfos    LoadInfo[]
  unloadItems  UnloadItem[]
  deleteStatus ApprovalStatus @default(DEFAULT)
  updateStatus ApprovalStatus @default(DEFAULT)

  @@unique([vataId, classType, className])
  @@map("classAndRates")
}

// ========================== INVOICE MODEL==================================
model Challan {
  id             String        @id @default(uuid())
  serial         Int
  chalanType     String
  deliveryDate   DateTime?
  challanDate    DateTime
  duePaymentDate DateTime?
  deliverySeason String?
  note           String?
  productPrice   Float
  discount       Float?
  carRent        Float?
  totalPrice     Float
  cash           Float?
  due            Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customerId     String
  vataId         String
  isDeleted      Boolean       @default(false)
  createdById    String
  seasonId       String
  items          ChallanItem[] @relation("ChallanItems")
  createdBy      User          @relation(fields: [createdById], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])
  season         Season        @relation(fields: [seasonId], references: [id])
  vata           Vata          @relation(fields: [vataId], references: [id])
  deliveries     Delivery[]
  customerDue    CustomerDue?

  @@unique([vataId, serial])
  @@map("chllans")
}

// ========================== INVOICE ITEMS MODEL==================================
model ChallanItem {
  id           String    @id @default(uuid())
  class        String
  rate         Float
  quantity     Int
  delivered    Int       @default(0)
  price        Float
  challanId    String
  deliveryDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  challan      Challan   @relation("ChallanItems", fields: [challanId], references: [id])

  @@map("challanItems")
}

// ========================== CUSTOMER MODEL==================================
model Customer {
  id              String           @id @default(uuid())
  customerCode    String
  name            String
  address         String
  phoneNumber     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  isDeleted       Boolean          @default(false)
  nextPaymentDate DateTime?
  note            String?
  vataId          String
  challans        Challan[]
  vata            Vata             @relation(fields: [vataId], references: [id])
  dueCollections  Due_Collection[]
  customerDues    CustomerDue[]

  @@unique([vataId, customerCode])
  @@map("customers")
}

// ========================== CUSTOMER DUE MODEL==================================
model CustomerDue {
  id         String @id @default(uuid())
  customerId String
  seasonId   String
  challanId  String

  totalAmount Decimal @db.Decimal(12, 2)
  paidAmount  Decimal @db.Decimal(12, 2)
  dueAmount   Decimal @db.Decimal(12, 2)

  customer Customer @relation(fields: [customerId], references: [id])
  season   Season   @relation(fields: [seasonId], references: [id])
  challan  Challan  @relation(fields: [challanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challanId])
  @@index([customerId, seasonId])
  @@map("customerdues")
}

// SELIVRY STATUS
enum DeliveryStatus {
  PENDING
  PROCESSING
  CANCEL
  DELIVERED
}

// ========================== DELIVERY MODEL==================================
model Delivery {
  id                        String                    @id @default(uuid())
  deliveryDate              DateTime
  deliveryNo                Int
  nextDeliveryDate          DateTime?
  quantity                  Int
  deliveryReceived          Int
  class                     String
  deliveryRemaining         Int
  carNo                     String?
  lastDelivered             Int?
  status                    DeliveryStatus            @default(PROCESSING)
  carRent                   Float?
  invoiceId                 String
  isDeleted                 Boolean                   @default(false)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  season                    String?
  deliveryById              String
  driverId                  String?
  driver                    Driver?                   @relation(fields: [driverId], references: [id])
  deliveryBy                User                      @relation(fields: [deliveryById], references: [id])
  invoice                   Challan                   @relation(fields: [invoiceId], references: [id])
  carIncomeDeliveries       CarIncomeDelivery[]
  deliveryStatusActionTimes DeliveryStatusActionTime?

  @@unique([invoiceId, deliveryNo])
  @@map("deliveries")
}

// ========================== DELIVERY STATUS TIME ACTION MODEL==================================
model DeliveryStatusActionTime {
  id             String    @id @default(uuid())
  deliveryId     String    @unique
  pendingTime    DateTime?
  processingTime DateTime?
  deliveredTime  DateTime?
  cancelTime     DateTime?
  delivery       Delivery  @relation(fields: [deliveryId], references: [id])
}

// ========================== DUE COLLECTION MODEL==================================
model Due_Collection {
  id       String    @id @default(uuid())
  due      Float
  collect  Float
  newDue   Float
  nextDate DateTime?

  customerId String
  seasonId   String

  isDeleted Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id])
  season   Season   @relation(fields: [seasonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, seasonId])
  @@map("duecollections")
}

// ========================== LEDGER MODEL==================================
model Ledger {
  id          String   @id @default(uuid())
  name        String
  serial      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  parentId    String?
  rate        Float?   @default(0)
  quantity    Float?   @default(0)
  isDeleted   Boolean  @default(false)
  vataId      String
  seasonId    String
  phoneNumber String?
  startDate   String?

  // নতুন ফিল্ড
  salary             Float?  @default(0)
  weeklyFood         Float?  @default(0)
  openingBalance     Float?  @default(0)
  openingBalanceType String?

  season   Season   @relation(fields: [seasonId], references: [id])
  parent   Ledger?  @relation("LedgerHierarchy", fields: [parentId], references: [id])
  children Ledger[] @relation("LedgerHierarchy")
  vata     Vata     @relation(fields: [vataId], references: [id])

  payments Payment[]

  @@unique([vataId, serial, name, seasonId])
}

// ========================== PAYMENT MODEL==================================
model Payment {
  id                String   @id @default(uuid())
  serial            Int      @default(autoincrement())
  quantity          Float    @default(0)
  cutting           Float    @default(0)
  payment           Float
  ledgerId          String
  vataId            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  document          String?
  paymentDetails    String?
  paymentDifference Float    @default(0)
  paymentType       String
  rate              Float    @default(0)
  address           String?
  totalBill         Float
  isDeleted         Boolean  @default(false)
  paymentDate       DateTime @default(now())
  ledger            Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  vata              Vata     @relation(fields: [vataId], references: [id])
}

// ========================== CASH MODEL==================================
model Cash {
  id          String   @id @default(uuid())
  type        CashType
  source      String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vataId      String
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id])
  vata        Vata     @relation(fields: [vataId], references: [id])

  @@index([type])
  @@index([createdAt])
  @@index([vataId])
  @@map("cash")
}

// ========================== ROUND MODEL==================================
model Round {
  id        String     @id @default(uuid())
  name      String
  vataId    String
  loadInfos LoadInfo[]
  seasonId  String
  season    Season     @relation(fields: [seasonId], references: [id])
  vata      Vata       @relation(fields: [vataId], references: [id])
  unloads   Unload[]

  @@unique([vataId, name, seasonId])
  @@index([vataId])
}

// LOAD INFO
enum LoadType {
  RAWENTRY
  RAW_TO_FIELD
  FIELD_TO_CHULLI
  STOCK_TO_CHULLI
  CHULLI_TO_FINISHED
  FIELD_TO_STOCK
}

// ========================== LOAD INFO MODEL==================================
model LoadInfo {
  id        String        @id @default(uuid())
  date      DateTime
  roundId   String
  quantity  Int
  loadType  LoadType
  classId   String?
  class     ClassAndRate? @relation(fields: [classId], references: [id])
  isDeleted Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  round     Round         @relation(fields: [roundId], references: [id])
}

// ========================== UNLOAD MODEL==================================
model Unload {
  id        String       @id @default(uuid())
  date      DateTime
  roundId   String
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  round     Round        @relation(fields: [roundId], references: [id])
  items     UnloadItem[]

  @@index([roundId])
}

// ========================== UNLOAD ITEMS MODEL==================================
model UnloadItem {
  id        String        @id @default(uuid())
  unloadId  String
  classId   String?
  quantity  Int           @default(0)
  damaged   Int           @default(0)
  unload    Unload        @relation(fields: [unloadId], references: [id])
  class     ClassAndRate? @relation(fields: [classId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([unloadId])
  @@index([classId])
}

// ========================== BRICK STOCK SUMMARY MODEL==================================
model BrickStockSummary {
  id          String   @id @default(uuid())
  vataId      String
  vata        Vata     @relation(fields: [vataId], references: [id])
  rawBrick    Int      @default(0)
  fieldBrick  Int      @default(0)
  stockBrick  Int      @default(0)
  chulliBrick Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vataId])
}

// ========================== STOCK BOOK MODEL==================================
model StockBook {
  id          String   @id @default(uuid())
  class       String
  stockIn     Int      @default(0)
  stockOut    Int      @default(0)
  description String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  seasonId    String
  season      Season   @relation(fields: [seasonId], references: [id])
  vataId      String
  vata        Vata     @relation(fields: [vataId], references: [id])
}

// ========================== GOODS STOCK CATEGORY MODEL==================================
model GoodsStockCategory {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  vataId      String
  isDeleted   Boolean      @default(false)
  vata        Vata         @relation(fields: [vataId], references: [id])
  goodsStocks GoodsStock[]
}

// ========================== GOOD STOCK MODEL==================================
model GoodsStock {
  id              String             @id @default(uuid())
  name            String
  shop            String
  quantity        Float
  price           Float
  warranty        DateTime?
  image           String?
  categoryId      String
  category        GoodsStockCategory @relation(fields: [categoryId], references: [id])
  vataId          String
  vata            Vata               @relation(fields: [vataId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  goodsIssues     GoodsIssue[]
  goodsLosses     GoodsLoss[]
  goodHistoryLogs GoodHistoryLog[]
}

// ========================== GOOD ISSUE MODEL==================================
model GoodsIssue {
  id        String     @id @default(uuid())
  name      String
  location  String
  quantity  Float
  date      DateTime
  image     String?
  goodId    String
  note      String?
  good      GoodsStock @relation(fields: [goodId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum GoodHistoryType {
  ISSUE
  RETURN
  LOST
  DEMAGE
}

// ========================== GOOD HISTORY LOG MODEL==================================
model GoodHistoryLog {
  id          String          @id @default(uuid())
  type        GoodHistoryType
  description String?
  receiveBy   String?
  quantity    Int
  returnBy    String?
  goodId      String
  date        DateTime
  good        GoodsStock      @relation(fields: [goodId], references: [id])
  damage      Int?
  lost        Int?
  okay        Int?
  image       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum GoodLossType {
  DAMAGED
  LOST
}

// ========================== GOOD LOSS MODEL==================================
model GoodsLoss {
  id         String       @id @default(uuid())
  goodId     String
  good       GoodsStock   @relation(fields: [goodId], references: [id])
  quantity   Float
  type       GoodLossType
  lossAmount Float
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// ========================== DOCUMENT MODEL==================================
model Document {
  id        String       @id @default(cuid())
  name      String
  type      DocumentType
  parentId  String?
  fileUrl   String?
  fileKey   String?
  mimeType  String?
  size      BigInt?
  extension String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  vataId    String
  parent    Document?    @relation("DocumentParent", fields: [parentId], references: [id])
  children  Document[]   @relation("DocumentParent")
  vata      Vata         @relation(fields: [vataId], references: [id])

  @@unique([parentId, name])
  @@index([type])
  @@index([parentId])
}

// ========================== CAR RENT MODEL==================================
model CarRent {
  id        String   @id @default(uuid())
  address   String
  area      String
  rent      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vataId    String
  vata      Vata     @relation(fields: [vataId], references: [id])

  @@map("carrents")
}

// ========================== PRODUCT MODEL==================================
model Product {
  id           Int       @id @default(autoincrement())
  productName  String
  category     String
  shop         String
  quantity     Int
  price        Decimal   @db.Decimal(12, 2)
  productImage String?
  warranty     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vataId       String
  vata         Vata      @relation(fields: [vataId], references: [id])

  @@index([category])
  @@index([shop])
  @@map("products")
}

// ========================== TASK MANAGER MODEL==================================
model TaskManager {
  id          String     @id @default(uuid())
  description String
  userId      String
  date        DateTime
  repeat      String
  status      TaskStatus @default(PENDING)
  vataId      String
  isDeleted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vata        Vata       @relation(fields: [vataId], references: [id])
}

// ========================== RECEIVABLE AND PAYABLE (DENA PAWNA) MODEL==================================
model ReceivablePayable {
  id              String                         @id @default(uuid())
  transactionType TransactionType
  amount          Decimal                        @db.Decimal(12, 2)
  currentAmount   Decimal                        @db.Decimal(12, 2)
  name            String
  phone           String?
  address         String?
  transactionDate DateTime
  paymentDate     DateTime?
  witnessOne      String?
  witnessTwo      String?
  description     String?
  isDeleted       Boolean                        @default(false)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  vataId          String
  vata            Vata                           @relation(fields: [vataId], references: [id])
  transactions    ReceivablePayableTransaction[]

  @@index([transactionType])
  @@index([phone])
  @@index([isDeleted])
}

// ========================== RECEIVABLE AND PAYABLE TRANSACTIONS (DENA PAWNA) MODEL==================================
model ReceivablePayableTransaction {
  id                  String            @id @default(uuid())
  receivablePayableId String
  type                TransactionType
  amount              Float
  transactionDate     DateTime
  remaining           Float
  description         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  vataId              String
  receivablePayable   ReceivablePayable @relation(fields: [receivablePayableId], references: [id], onDelete: Cascade)
  vata                Vata              @relation(fields: [vataId], references: [id])

  @@index([receivablePayableId])
  @@index([transactionDate])
}

// ========================== CONTACT MODEL==================================
model Contact {
  id         String   @id @default(uuid())
  name       String
  address    String
  occupation String
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  vataId     String
  vata       Vata     @relation(fields: [vataId], references: [id])
}

// ========================== WEATHER MODEL==================================
model Weather {
  id        String   @id @default(uuid())
  linkOne   String?
  linkTwo   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vataId    String
  vata      Vata     @relation(fields: [vataId], references: [id])
}

// ========================== VATA MODEL==================================
model Vata {
  id                        String  @id @default(uuid())
  vataId                    String  @unique
  nameEnglish               String
  nameBangla                String
  additionalAddress         String?
  shortDescription          String?
  address                   String
  ownerName                 String
  ownerPhoneNumber          String
  shortForm                 String?
  challanManagerPhoneNumber String?

  challanPersonOneName        String?
  challanPersonOnePhoneNumber String?

  challanPersonTwoName          String?
  challanPersonTwoPhoneNumber   String?
  nextPaymentDate               DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  subdomain                     String                         @unique
  status                        VataStatus                     @default(ACTIVE)
  subscriptionPlanId            String?
  subscriptionPlan              SubscriptionPlan?              @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionStart             DateTime?
  subscriptionEnd               DateTime?
  contacts                      Contact[]
  documents                     Document[]
  ledgers                       Ledger[]
  payments                      Payment[]
  receivablePayables            ReceivablePayable[]
  receivablePayableTransactions ReceivablePayableTransaction[]
  rounds                        Round[]
  taskManagers                  TaskManager[]
  weather                       Weather[]
  carRents                      CarRent[]
  cash                          Cash[]
  challans                      Challan[]
  classAndRate                  ClassAndRate[]
  customers                     Customer[]
  products                      Product[]
  users                         User[]
  drivers                       Driver[]
  subscriptionPayments          SubscriptionPayment[]
  stocks                        StockBook[]
  goodsStockCategories          GoodsStockCategory[]
  goodsStocks                   GoodsStock[]
  brickStockSummaries           BrickStockSummary[]
  vataCars                      VataCar[]
  smsRechargeHistories          SmsRechargeHistory[]
  smsWallet                     SmsWallet?
  vataSmsSettings               VataSmsSettings[]
  smsLogs                       SmsLog[]
  notifications                 Notification[]
  seasons                       Season[]
  approvalRequests              ApprovalRequest[]
  activityLogs                  ActivityLog[]

  @@map("vatainformation")
}

// SUBSCRIPTION PLAN
enum SubscriptionPlanType {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// ========================== SUBSCRIPTION MODEL==================================
model SubscriptionPlan {
  id                   String                @id @default(uuid())
  name                 String                @unique
  type                 SubscriptionPlanType  @unique
  description          String?
  price                Decimal               @db.Decimal(12, 2)
  billingCycle         BillingCycle
  features             String[]
  maxUsers             Int?
  maxStorage           Int? // GB
  maxTasks             Int?
  maxInvoices          Int?
  maxSms               Int?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  vatas                Vata[]
  subscriptionPayments SubscriptionPayment[]
}

// ========================== SUBSCRIPTION PAYMENT MODEL==================================
model SubscriptionPayment {
  id                 String                    @id @default(uuid())
  vataId             String
  vata               Vata                      @relation(fields: [vataId], references: [id])
  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan          @relation(fields: [subscriptionPlanId], references: [id])
  startDate          DateTime?
  endDate            DateTime?
  amount             Decimal                   @db.Decimal(12, 2)
  status             SubscriptionPaymentStatus @default(PENDING)
  paidAt             DateTime                  @default(now())
  paymentMethod      String
  transactionId      String
  phoneNumber        String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

// ========================== SEASON MODEL==================================
model Season {
  id     String @id @default(uuid())
  vataId String

  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vata           Vata             @relation(fields: [vataId], references: [id], onDelete: Cascade)
  challans       Challan[]
  customerDues   CustomerDue[]
  dueCollections Due_Collection[]
  cash           Cash[]
  ledgers        Ledger[]
  rounds         Round[]
  stockBooks     StockBook[]
  notifications  Notification[]

  @@unique([vataId, name])
  @@index([vataId, isActive])
}

// ========================== DRIVER MODEL==================================
model Driver {
  id                  String              @id @default(uuid())
  name                String
  PhoneNumber         String
  salary              Decimal             @db.Decimal(12, 2)
  vataId              String
  vata                Vata                @relation(fields: [vataId], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deliveries          Delivery[]
  carIncomeDeliveries CarIncomeDelivery[]
}

// ========================== VATA CAR MODEL==================================
model VataCar {
  id                  String              @id @default(uuid())
  vataId              String
  carNo               String
  vata                Vata                @relation(fields: [vataId], references: [id])
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  carIncomeDeliveries CarIncomeDelivery[]
}

// ========================== CAR INCOME DELIVERY MODEL==================================
model CarIncomeDelivery {
  id         String   @id @default(uuid())
  amount     Float
  driverId   String
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id])
  driver     Driver   @relation(fields: [driverId], references: [id])
  carId      String
  car        VataCar  @relation(fields: [carId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

//=============================== SMS PART=========================================
// ========================== SMS SETTINGS MODEL==================================
model SmsSetting {
  id         String   @id @default(uuid())
  ratePerSms Decimal  @db.Decimal(10, 4)
  bkash      String?
  rocket     String?
  nogod      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================  SMS WALLET VATA MODEL==================================
model SmsWallet {
  id     String @id @default(uuid())
  vataId String @unique

  balance        Float    @default(0)
  totalPurchased Int      @default(0)
  totalUsed      Int      @default(0)
  currentRate    Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vata Vata @relation(fields: [vataId], references: [id])
}

// ========================== SMS HISTORY MODEL==================================
model SmsRechargeHistory {
  id            String            @id @default(uuid())
  vataId        String
  smsQuantity   Int
  ratePerSms    Decimal           @db.Decimal(10, 4)
  totalAmount   Decimal           @db.Decimal(12, 2)
  paymentMethod String?
  transactionId String?
  phoneNumber   String?
  type          SmsPaymentType
  status        SmsRechargeStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  vata          Vata              @relation(fields: [vataId], references: [id])
}

enum SmsPaymentType {
  MANUAL
  BKASH
}

enum SmsRechargeStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// ========================== VATA SMS SETTINGS MODEL==================================
// KOI KOI SMS JABE 
model VataSmsSettings {
  id                  String  @id @default(uuid())
  newInvoice          Boolean @default(false)
  updateInvoice       Boolean @default(false)
  deleteInvoice       Boolean @default(false)
  newDelivery         Boolean @default(false)
  newDueCollection    Boolean @default(false)
  deuCollectionUpdate Boolean @default(false)
  vataId              String
  vata                Vata    @relation(fields: [vataId], references: [id])

  @@unique([vataId])
}

// SMS LOG
enum SmsStatus {
  SENT
  FAILED
}

// ========================== SMS LOG MODEL==================================
model SmsLog {
  id          String    @id @default(uuid())
  vataId      String
  phoneNumber String
  message     String
  status      SmsStatus
  sendBy      String
  cost        Float
  sentAt      DateTime  @default(now())
  vata        Vata      @relation(fields: [vataId], references: [id])

  @@index([vataId])
  @@index([phoneNumber])
  @@index([status])
  @@index([sentAt])
}

model Note {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NOTIFICATION
enum NotificationType {
  DUE
  DELIVERY
}

// ========================== NOTIFICATION MODEL==================================
model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  path      String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  vataId    String
  vata      Vata             @relation(fields: [vataId], references: [id])
  seasonId  String
  season    Season           @relation(fields: [seasonId], references: [id])
}

// ============================FAQ SUPER ADMIN PART=================================
model Faq {
  id          String   @id @default(uuid())
